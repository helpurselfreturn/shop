:root {
  --font-main: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-header: 'Oswald', sans-serif;
  --font-dot: 'DotGothic16', sans-serif;
  --color-black: #000000;
  --color-white: #ffffff;
  --color-gray-100: #f8f8f8;
  --color-gray-200: #e5e5e5;
  --color-gray-300: #d4d4d4;
  --color-gray-500: #737373;
  --color-gray-700: #404040;
  --color-shop-purple: #5a31f4;
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --spacing-2xl: 48px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 14px;
}

body {
  font-family: var(--font-dot);
  color: var(--color-black);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  background: var(--color-white);
}

a {
  text-decoration: none;
  color: inherit;
}

ul {
  list-style: none;
}

button {
  border: none;
  background: none;
  cursor: pointer;
  font-family: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
}

/* ===============================
   PROMO BAR
================================== */
.promo-bar {
  background-color: var(--color-black);
  color: var(--color-white);
  text-align: center;
  padding: var(--spacing-sm) 0;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.promo-bar a {
  color: var(--color-white);
  text-decoration: underline;
}

/* ===============================
   HEADER
================================== */
.site-header {
  background: var(--color-white);
  border-bottom: 1px solid var(--color-gray-200);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60px;
  gap: var(--spacing-lg);
}

/* Logo */
.logo {
  display: flex;
  align-items: center;
  color: var(--color-black);
  flex-shrink: 0;
}

.logo svg {
  width: 40px;
  height: 40px;
}

.logo-video {
  width: 60px;
  height: 60px;
  object-fit: contain;
  display: block;
}

.logo-img {
  width: 100px;
  height: 100px;
  object-fit: contain;
  display: block;
}

/* Main Navigation */
.main-nav {
  flex: 1;
  display: flex;
  justify-content: center;
}

.main-nav ul {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
}

.main-nav a {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  white-space: nowrap;
  transition: opacity 0.2s;
}

.main-nav a:hover {
  opacity: 0.7;
}

.main-nav .nav-sale {
  color: #c00;
}

/* Header Actions */
.header-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex-shrink: 0;
}

.icon-btn {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--color-black);
  transition: opacity 0.2s;
}

.icon-btn:hover {
  opacity: 0.7;
}

.icon-btn svg {
  width: 18px;
  height: 18px;
}

.currency-btn {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  border: 1px solid var(--color-gray-300);
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: 2px;
}

.currency-btn .flag {
  font-size: 14px;
}

/* ===============================
   MAIN CONTENT
================================== */
.main-content {
  padding: var(--spacing-xl) 0 var(--spacing-2xl);
}

.product-page {
  display: grid;
  grid-template-columns: 1fr 400px;
  gap: var(--spacing-2xl);
  align-items: start;
}

/* ===============================
   PRODUCT GALLERY
================================== */
.product-gallery {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-sm);
}

.gallery-item {
  background: var(--color-gray-100);
  aspect-ratio: 3/4;
  overflow: hidden;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gallery-thumbs {
  display: flex;
  gap: var(--spacing-sm);
}

.thumb {
  width: 80px;
  height: 100px;
  border: 1px solid transparent;
  background: var(--color-gray-100);
  padding: 0;
  overflow: hidden;
  transition: border-color 0.2s;
}

.thumb:hover,
.thumb.active {
  border-color: var(--color-black);
}

.thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===============================
   PRODUCT DETAILS
================================== */
.product-details {
  position: sticky;
  top: 80px;
}

.product-title {
  font-family: var(--font-header);
  font-size: 24px;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 1px;
  line-height: 1.2;
  margin-bottom: var(--spacing-sm);
}

.product-price {
  font-size: 16px;
  font-weight: 400;
  margin-bottom: var(--spacing-sm);
}

.product-installments {
  font-size: 12px;
  color: var(--color-gray-500);
  margin-bottom: var(--spacing-lg);
}

.product-installments a {
  text-decoration: underline;
}

.shop-badge {
  display: inline-block;
  background: var(--color-shop-purple);
  color: white;
  padding: 2px 6px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: 700;
  font-style: italic;
  vertical-align: middle;
}

/* Color */
.product-color {
  margin-bottom: var(--spacing-lg);
}

.product-color .label {
  display: block;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.5px;
  margin-bottom: var(--spacing-sm);
}

.color-swatches {
  display: flex;
  gap: var(--spacing-sm);
}

.color-swatch {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--color-gray-300);
  cursor: pointer;
  position: relative;
}

.color-swatch.selected::after {
  content: '';
  position: absolute;
  inset: -4px;
  border: 1px solid var(--color-black);
  border-radius: 50%;
}

/* Size */
.product-size {
  margin-bottom: var(--spacing-lg);
}

.size-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  font-size: 12px;
}

.size-chart {
  text-decoration: underline;
  font-weight: 500;
}

.fit-info {
  color: var(--color-gray-500);
}

.size-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.size-btn {
  min-width: 44px;
  height: 36px;
  padding: 0 var(--spacing-md);
  border: 1px solid var(--color-gray-300);
  font-size: 12px;
  font-weight: 500;
  background: var(--color-white);
  transition: all 0.2s;
}

.size-btn:hover:not(.disabled) {
  border-color: var(--color-black);
}

.size-btn.selected {
  background: var(--color-black);
  color: var(--color-white);
  border-color: var(--color-black);
}

.size-btn.disabled {
  color: var(--color-gray-300);
  cursor: not-allowed;
  text-decoration: line-through;
}

/* Buttons */
.add-to-bag-btn {
  width: 100%;
  height: 50px;
  background: var(--color-black);
  color: var(--color-white);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: var(--spacing-sm);
  transition: opacity 0.2s;
}

.add-to-bag-btn:hover {
  opacity: 0.85;
}

.shop-pay-btn {
  width: 100%;
  height: 50px;
  background: var(--color-shop-purple);
  color: var(--color-white);
  font-size: 14px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-sm);
}

.shop-pay-btn .shop-logo {
  font-weight: 900;
  font-style: italic;
}

.more-payment {
  display: block;
  text-align: center;
  font-size: 12px;
  text-decoration: underline;
  color: var(--color-gray-500);
  margin-bottom: var(--spacing-xl);
}

/* ===============================
   ACCORDIONS
================================== */
.accordions {
  border-top: 1px solid var(--color-gray-200);
}

details {
  border-bottom: 1px solid var(--color-gray-200);
}

summary {
  padding: var(--spacing-md) 0;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  user-select: none;
}

summary::-webkit-details-marker {
  display: none;
}

summary::after {
  content: '+';
  font-size: 18px;
  font-weight: 300;
}

details[open] summary::after {
  content: '−';
}

.accordion-content {
  padding-bottom: var(--spacing-lg);
  font-size: 13px;
  line-height: 1.7;
}

.accordion-content p {
  margin-bottom: var(--spacing-md);
}

.accordion-content h4 {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin: var(--spacing-md) 0 var(--spacing-sm);
}

.accordion-content ul {
  list-style: disc;
  padding-left: var(--spacing-lg);
}

.accordion-content li {
  margin-bottom: var(--spacing-xs);
}

/* ===============================
   DARK THEME PRODUCT PAGE
================================== */
/* ===============================
   DARK THEME PRODUCT PAGE (PREMIUM REDESIGN)
================================== */
.dark-theme {
  background: #0a0a0a;
  /* Slightly softer black for depth */
  color: var(--color-white);
}

.dark-header {
  background: rgba(10, 10, 10, 0.95);
  border-bottom: 1px solid #222;
  backdrop-filter: blur(10px);
}

.dark-header .logo-img {
  filter: brightness(0) invert(1);
}

.product-content {
  background: #0a0a0a;
  min-height: 100vh;
  padding: var(--spacing-2xl) 0;
}

/* Grid Layout */
.product-page-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  /* Gallery takes more space */
  gap: 60px;
  align-items: start;
}

/* Vertical Gallery */
.product-gallery-vertical {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.gallery-image {
  width: 100%;
  background: #111;
  border-radius: 4px;
  overflow: hidden;
}

.gallery-image img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.5s ease;
}

.gallery-image:hover img {
  transform: scale(1.02);
}

/* Sticky Info Panel */
.product-info-sticky {
  position: sticky;
  top: 100px;
  /* Offset for header */
  height: fit-content;
}

.product-info-card {
  /* Removed background card look for cleaner "floating" look */
  padding: 0;
  color: var(--color-white);
}

.product-name {
  font-family: 'Oswald', sans-serif;
  /* Premium header font */
  font-size: 32px;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: var(--spacing-sm);
  line-height: 1.1;
  letter-spacing: 0.5px;
}

.product-price-large {
  font-family: var(--font-dot);
  /* Keep for tech/retro accent */
  font-size: 24px;
  color: #4ade80;
  /* Matrix/Tech green accent */
  margin-bottom: var(--spacing-lg);
  display: inline-block;
  background: rgba(74, 222, 128, 0.1);
  padding: 4px 12px;
  border-radius: 4px;
}

.product-desc {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  line-height: 1.6;
  color: #ccc;
  margin-bottom: var(--spacing-xl);
  max-width: 90%;
}

.made-in-text {
  margin-top: 12px;
  color: #666;
  font-size: 13px;
  font-style: italic;
}

/* Size Selection */
.size-section {
  margin-bottom: var(--spacing-xl);
}

.size-label {
  display: block;
  font-family: var(--font-dot);
  font-size: 14px;
  color: #888;
  margin-bottom: var(--spacing-md);
  text-transform: uppercase;
}

.size-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.size-btn {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1px solid #333;
  color: #fff;
  font-family: 'Oswald', sans-serif;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.2s;
  cursor: pointer;
}

.size-btn:hover {
  border-color: #fff;
  background: #fff;
  color: #000;
}

/* Features */
.features-list {
  margin-bottom: var(--spacing-xl);
  border-top: 1px solid #222;
  padding-top: var(--spacing-lg);
}

.feature-item {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: #999;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Telegram Button (CTA) */
.telegram-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  padding: 18px;
  background: #fff;
  color: #000;
  font-family: 'Oswald', sans-serif;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 0;
  /* Sharp edges for streetwear feel */
  transition: transform 0.2s, background 0.2s;
}

.telegram-btn:hover {
  background: #e5e5e5;
  transform: translateY(-2px);
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .product-page-grid {
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }

  .product-gallery-vertical {
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--spacing-md);
  }

  .gallery-image {
    min-width: 85vw;
    scroll-snap-align: center;
  }

  .product-info-sticky {
    position: static;
  }
}

/* Language Switcher */
.language-switch {
  display: flex;
  align-items: center;
  gap: 4px;
  position: absolute;
  right: var(--spacing-lg);
}

.lang-btn {
  font-family: 'Oswald', sans-serif;
  font-size: 14px;
  font-weight: 500;
  color: #666;
  cursor: pointer;
  padding: 0;
  transition: color 0.2s;
}

.lang-btn:hover {
  color: #fff;
}

.lang-btn.active {
  color: #fff;
  font-weight: 700;
}

.lang-sep {
  color: #444;
  font-size: 12px;
}

/* Breadcrumbs */
.breadcrumbs {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: var(--spacing-lg);
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  color: #666;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.breadcrumbs a {
  color: #666;
  transition: color 0.2s;
}

.breadcrumbs a:hover {
  color: #fff;
}

.breadcrumbs .separator {
  color: #444;
}

.breadcrumbs .current {
  color: #fff;
}

/* Accordions */
.accordions {
  margin-top: var(--spacing-xl);
  border-top: 1px solid #222;
}

details {
  border-bottom: 1px solid #222;
}

summary {
  padding: 20px 0;
  cursor: pointer;
  font-family: 'Oswald', sans-serif;
  font-size: 14px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #fff;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: color 0.2s;
}

summary:hover {
  color: #ccc;
}

summary::-webkit-details-marker {
  display: none;
}

summary::after {
  content: '+';
  font-size: 18px;
  font-weight: 300;
}

details[open] summary::after {
  content: '−';
}

.accordion-content {
  padding-bottom: 20px;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #999;
}

.accordion-content ul {
  list-style: none;
  padding: 0;
}

.accordion-content li {
  margin-bottom: 6px;
}

/* Related Products */
.related-products {
  margin-top: 100px;
  padding-top: 60px;
  border-top: 1px solid #222;
}

.section-title {
  font-family: 'Oswald', sans-serif;
  font-size: 24px;
  font-weight: 700;
  text-transform: uppercase;
  color: #fff;
  margin-bottom: 40px;
  text-align: center;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.related-card {
  display: block;
  text-decoration: none;
}

.related-image {
  background: #111;
  aspect-ratio: 3/4;
  overflow: hidden;
  margin-bottom: 16px;
}

.related-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.related-card:hover .related-image img {
  transform: scale(1.05);
}

.related-title {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: #fff;
  margin-bottom: 4px;
  text-transform: uppercase;
}

.related-price {
  font-family: var(--font-dot);
  font-size: 14px;
  color: #666;
}

@media (max-width: 768px) {
  .related-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.home-content {
  background: var(--color-black);
  min-height: 100vh;
  padding: var(--spacing-md) 0;
}

.home-content .container {
  padding: 0 var(--spacing-sm);
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-sm);
}

.category-card {
  display: block;
  text-decoration: none;
}

.category-image {
  aspect-ratio: 3/4;
  overflow: hidden;
  background: var(--color-gray-700);
}

.category-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s;
}

.category-card:hover .category-image img {
  transform: scale(1.05);
}

.category-title {
  font-family: var(--font-dot);
  font-size: 16px;
  font-weight: 400;
  color: var(--color-white);
  margin-top: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

/* Telegram Button */
.telegram-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  width: 100%;
  padding: var(--spacing-md) var(--spacing-lg);
  margin-top: var(--spacing-lg);
  background: #0088cc;
  color: var(--color-white);
  font-family: var(--font-dot);
  font-size: 16px;
  font-weight: 500;
  text-decoration: none;
  border-radius: 8px;
  transition: background 0.2s;
}

.telegram-btn:hover {
  background: #0077b5;
}

.telegram-btn svg {
  flex-shrink: 0;
}

/* Mobile Menu Button */
.mobile-menu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-black);
}

.logo-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

/* ===============================
   FOOTER
================================== */
.site-footer {
  background: var(--color-gray-100);
  padding: var(--spacing-xl) 0;
  text-align: center;
  font-size: 12px;
  color: var(--color-gray-500);
}

/* ===============================
   RESPONSIVE
================================== */
@media (max-width: 1200px) {
  .main-nav ul {
    gap: var(--spacing-md);
  }

  .main-nav a {
    font-size: 11px;
  }
}

@media (max-width: 1024px) {
  .product-page {
    grid-template-columns: 1fr;
  }

  .product-details {
    position: static;
  }

  .main-nav {
    display: none;
  }
}

@media (max-width: 768px) {
  .gallery-grid {
    grid-template-columns: 1fr;
  }

  .header-actions span:not(.flag) {
    display: none;
  }

  .icon-btn svg {
    width: 22px;
    height: 22px;
  }
}